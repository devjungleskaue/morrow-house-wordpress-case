{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": { "palette": [
      { "slug": "paper", "name": "Paper", "color": "#F7F3EC" },
      { "slug": "ink", "name": "Ink", "color": "#1D2420" },
      { "slug": "pine", "name": "Pine", "color": "#28483B" },
      { "slug": "clay", "name": "Clay", "color": "#B96F4A" },
      { "slug": "line", "name": "Line", "color": "#D8D0C4" }
    ] },
    "layout": { "contentSize": "760px", "wideSize": "1240px" },
    "spacing": { "units": ["px", "rem", "vw"] },
    "typography": { "fluid": true, "fontFamilies": [
      { "slug": "display", "name": "Display", "fontFamily": "Georgia, 'Times New Roman', serif" },
      { "slug": "body", "name": "Body", "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
    ] }
  }
}
