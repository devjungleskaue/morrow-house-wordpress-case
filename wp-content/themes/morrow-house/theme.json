{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#F7F3EC"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#1D2420"
        },
        {
          "slug": "pine",
          "name": "Pine",
          "color": "#28483B"
        },
        {
          "slug": "clay",
          "name": "Clay",
          "color": "#B96F4A"
        },
        {
          "slug": "clay-ink",
          "name": "Clay ink",
          "color": "#9D5733"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#D8D0C4"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5A655F"
        }
      ]
    },
    "layout": {
      "contentSize": "37rem",
      "wideSize": "1180px"
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "vw"
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "Georgia,\"Times New Roman\",serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": ".78rem"
        },
        {
          "slug": "sub",
          "name": "Sub",
          "size": "clamp(1.15rem,1.8vw,1.45rem)"
        },
        {
          "slug": "section",
          "name": "Section",
          "size": "clamp(1.8rem,3.6vw,3rem)"
        },
        {
          "slug": "title",
          "name": "Title",
          "size": "clamp(2.8rem,7vw,6.8rem)"
        }
      ]
    }
  }
}
